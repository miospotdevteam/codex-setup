{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "summary",
    "planJson",
    "masterPlanMarkdown",
    "notes"
  ],
  "properties": {
    "summary": {
      "type": "string"
    },
    "planJson": {
      "type": "object"
    },
    "masterPlanMarkdown": {
      "type": "string"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
