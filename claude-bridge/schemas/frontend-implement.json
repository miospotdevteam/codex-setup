{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "summary",
    "changes",
    "deviations",
    "observations",
    "needsCodexFollowUp",
    "followUpSuggestions"
  ],
  "properties": {
    "summary": {
      "type": "string"
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "deviations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "needsCodexFollowUp": {
      "type": "boolean"
    },
    "followUpSuggestions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}

